# Change this value before any public or production deployment (minimum 32 characters).
JWT_SECRET=development-only-secret-change-me-123456

# Infrastructure credentials. Change all of them for a public deployment.
POSTGRES_DB=miem3dprint
POSTGRES_USER=miem
POSTGRES_PASSWORD=miem
DATABASE_URL=postgres://miem:miem@db:5432/miem3dprint?sslmode=disable&statement_timeout=15000&lock_timeout=5000
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Production SMTP example. Leave credentials empty to use Mailpit in Docker Compose.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@miem-3d-lab.local
SITE_URL=http://localhost:3000
