# Local development defaults use Mailpit from backend/docker-compose.yml.
# For production, replace these values with the real SMTP provider credentials.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@miem-3d-lab.local
SITE_URL=http://localhost:3000

DATABASE_URL=postgres://miem:miem@localhost:5432/miem3dprint?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m

JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars

HTTP_ADDRESS=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=2m
HTTP_WRITE_TIMEOUT=2m
HTTP_IDLE_TIMEOUT=1m

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=3d-files
MINIO_USE_SSL=false

# Comma-separated list of allowed frontend origins for CORS (dev only).
# Leave empty when running behind a reverse proxy on the same origin.
# Example: CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY=false
